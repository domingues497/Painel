# URL completa da API JSON-RPC do Zabbix. Deixe vazia para usar dados demonstrativos.
ZABBIX_URL=

# Token de API de um usuário dedicado somente à leitura.
ZABBIX_AUTH_TYPE=token
ZABBIX_TOKEN=
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Hosts técnicos de switches, separados por vírgula.
SWITCH_HOSTS=

# Cache e disponibilidade
CACHE_TTL=15
VERIFY_TLS=1
AVAIL_HOURS=24
STALE_SECONDS=900

# Grupos de hosts no Zabbix (separados por vírgula)
SERVER_GROUPS=Linux servers,Windows servers,Servidores
WORKSTATION_GROUPS=Workstations,Computadores,Desktops
SWITCH_GROUPS=Switches
WAN_GROUPS=WAN,Links WAN,Operadoras
NETWORK_GROUPS=Rede,Network,Roteadores,Routers,Firewalls,Wireless,Energia

# Regras de reconhecimento de interfaces
PORT_PATTERN=^(ether|sfp|qsfp|combo|Gi|Fa|Te|Eth|Port)
WAN_IF_PATTERN=\b(wan|operadora|isp)\b

# Nomes das tags dos hosts
TAG_UNIT=unidade
TAG_CRIT=criticidade
CRIT_HIGH=alta,alto,crítica,critica,crítico,critico,high,critical
